# Copy to deploy/demo/.env on the server and fill in. Never commit the real file.

# --- Address ---------------------------------------------------------------
# sslip.io turns the IP inside the name into the server's IP: no domain needed.
PUBLIC_URL=https://erp.169-58-40-189.sslip.io

# Option A, ports 80 and 443 are free on the server: Caddy serves HTTPS itself.
SITE_ADDRESS=erp.169-58-40-189.sslip.io
WEB_HTTP_BIND=80
WEB_HTTPS_BIND=443

# Option B, another proxy (nginx, Traefik, ...) already uses 80/443:
# Caddy listens only on the server itself; your proxy forwards the hostname to it
# and handles HTTPS. Comment out option A and use:
# SITE_ADDRESS=:80
# WEB_HTTP_BIND=127.0.0.1:8090
# WEB_HTTPS_BIND=127.0.0.1:8443

# --- Database (only reachable inside the compose network) -----------------
DB_NAME=school_erp
DB_USERNAME=school
# openssl rand -hex 24
DB_PASSWORD=

# --- Secrets ---------------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (keep a copy: Aadhaar numbers can't be read without it)
APP_ENCRYPTION_KEY=

# --- Demo logins -----------------------------------------------------------------
# Password for every demo user (principal, admin, accountant, teacher1, ...).
# Pick your own; don't reuse Demo@12345 on a public server.
DEMO_SEED_PASSWORD=
