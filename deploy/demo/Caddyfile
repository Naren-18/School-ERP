# SITE_ADDRESS is a hostname (Caddy gets a Let's Encrypt certificate, ports 80/443)
# or ":80" when another proxy on the server handles HTTPS and forwards here.
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy app:8080
	}

	# For uptime monitoring: the status only, no details.
	handle /actuator/health {
		reverse_proxy app:8080
	}

	handle {
		root * /srv
		# Hashed build files never change: cache for a year. index.html is never cached.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
}
