# Copy to .env (git-ignored) and adjust. Used by docker compose and by the
# backend's dev profile (spring imports ../.env).

# --- Database (docker-compose.yml + backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_erp
DB_USERNAME=school
DB_PASSWORD=school

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Frontend origin allowed by CORS
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
# HMAC secret for signing JWTs (>= 32 random bytes in prod)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Base64-encoded 32-byte AES-GCM key for Aadhaar encryption
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMmJ5dGVzISE=
# Local file storage directory (dev); prod uses R2 (vars added in phase 10)
FILE_STORAGE_LOCAL_DIR=./data/files
# Password for the dev-seeded users (dev profile only)
DEV_SEED_PASSWORD=Demo@12345
# Password for the demo schools' users (profile "demo" + --seed-demo; see README).
# Required when seeding; there is no default. Pick your own for a hosted demo.
DEMO_SEED_PASSWORD=Demo@12345
# --- WhatsApp messages to parents (Meta Cloud API) ---
# Leave empty to only write messages to the backend log (no Meta account needed).
# From developers.facebook.com -> your app -> WhatsApp -> API Setup. Use a
# system user token: the token on that page expires after 24 hours.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional, default v23.0
# WHATSAPP_API_VERSION=v23.0

# --- Online fee payment at the counter (Razorpay) ---
# Leave empty to hide online payment. Test keys start with rzp_test_:
# dashboard.razorpay.com -> Test mode -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional size: students per section (about) and days of attendance history
# DEMO_STUDENTS_PER_SECTION=15
# DEMO_ATTENDANCE_DAYS=60
