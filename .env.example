# Copy to .env (git-ignored) and adjust. Used by docker compose and by the
# backend's dev profile (spring imports ../.env).

# --- Database (docker-compose.yml + backend) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_erp
DB_USERNAME=school
DB_PASSWORD=school

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
# Frontend origin allowed by CORS
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
# HMAC secret for signing JWTs (>= 32 random bytes in prod)
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Base64-encoded 32-byte AES-GCM key for Aadhaar encryption
# Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMmJ5dGVzISE=
# Local file storage directory (dev); prod uses R2 (vars added in phase 10)
FILE_STORAGE_LOCAL_DIR=./data/files
